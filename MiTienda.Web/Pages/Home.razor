@page "/"

<PageTitle>MiTienda</PageTitle>

<section class="portada">
    <div>
        <span class="etiqueta">Tienda en línea</span>
        <h1>Todo lo de tu tienda, en un solo lugar</h1>
        <p>
            Registra a tus clientes, mantén sus datos al día y tenlos a mano
            cuando los necesites.
        </p>
        <a class="btn btn-tienda" href="clientes">Ver clientes</a>
    </div>

    <div class="portada-caja">
        <div class="bolsa">🛍️</div>
    </div>
</section>

<section class="ventajas">
    <div class="ventaja">
        <div class="ventaja-icono">🚚</div>
        <h3>Envíos</h3>
        <p>Llevamos tus pedidos a la puerta de la casa.</p>
    </div>
    <div class="ventaja">
        <div class="ventaja-icono">💳</div>
        <h3>Pagos fáciles</h3>
        <p>Efectivo, transferencia o tarjeta.</p>
    </div>
    <div class="ventaja">
        <div class="ventaja-icono">🤝</div>
        <h3>Atención</h3>
        <p>Conocemos a cada cliente por su nombre.</p>
    </div>
</section>
